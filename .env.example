MI_FITNESS_STATE_PATH=~/.running_portal/auth.json
MI_FITNESS_CACHE_DIR=~/.running_portal/fds_cache
MI_FITNESS_COUNTRY_CODE=RU
# Optional: enables silent re-login when Xiaomi rejects the saved serviceToken.
# If omitted, open the UI and log in again when Mi Fitness returns 401.
MI_FITNESS_EMAIL=
MI_FITNESS_PASSWORD=
DB_PATH=~/.running_portal/portal.db
CLAUDE_CLI_PATH=/home/hram/.local/bin/claude
ANTHROPIC_API_KEY=
AUTO_SYNC_INTERVAL_HOURS=1
MORNING_SYNC_TIME=09:00
PORT=8000
