PORT=8000
DB_PATH=/data/running-portal/portal.db
MI_FITNESS_STATE_PATH=/data/running-portal/auth.json
MI_FITNESS_CACHE_DIR=/data/running-portal/fds_cache
MI_FITNESS_COUNTRY_CODE=RU
MI_FITNESS_EMAIL=
MI_FITNESS_PASSWORD=
AUTO_SYNC_INTERVAL_HOURS=1
MORNING_SYNC_TIME=09:00

# Claude Code is installed in the production Docker image.
# Its auth files are expected under HOME/.claude.
HOME=/data/running-portal
CLAUDE_CLI_PATH=/usr/local/bin/claude
ANTHROPIC_API_KEY=
